# ==============================================================================
# UNMASKED: Beyond "I'm Fine" — Environment Variables
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi `.env.local`
#    Contoh: cp .env.example .env.local
# 2. Dapatkan Gemini API Key gratis dari Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 3. Masukkan API Key Anda pada variabel di bawah ini:
# ==============================================================================

GEMINI_API_KEY=your_gemini_api_key_here
