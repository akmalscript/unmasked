# ==============================================================================
# UNMASKED: Beyond "I'm Fine" — Environment Variables
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi `.env.local`
#    Contoh: cp .env.example .env.local
# 2. Dapatkan Gemini API Key gratis dari Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 3. Masukkan API Key Anda pada variabel di bawah ini:
# ==============================================================================

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Model untuk task ringan / structured / high-volume
GEMINI_STANDARD_MODEL=gemini-3.5-flash-lite

# Model untuk task yang membutuhkan contextual reasoning lebih tinggi
GEMINI_COMPLEX_MODEL=gemini-3.8-flash

# Model khusus Safety AI (digunakan oleh Safety V2)
GEMINI_SAFETY_MODEL=gemini-3.5-flash-lite
